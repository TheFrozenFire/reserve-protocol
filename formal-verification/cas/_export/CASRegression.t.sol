    // ---- FixLib.powu boundary cases ----
    // Source: cas/fixlib/powu_correctness.gp
    function test_powu_boundary() public pure {
        assertEq(uint256(FixLib.powu(uint192(FIX_ONE / 2), uint48(0))), uint256(FIX_ONE));   // x^0 == 1
        assertEq(uint256(FixLib.powu(uint192(FIX_ONE / 2), uint48(1))), uint256(FIX_ONE / 2)); // x^1 == x
        assertEq(uint256(FixLib.powu(uint192(FIX_ONE), uint48(100))), uint256(FIX_ONE));   // 1^N == 1
