        // Minimum-overflow class: a*b/c == FIX_MAX + 1 (single-bit overshoot).
        assertEq(uint256(FixLib.safeMulDiv(uint192(2**96), uint192(2**96), uint192(1), CEIL)), uint256(FIX_MAX));
        assertEq(uint256(FixLib.safeMulDiv(uint192(2**96), uint192(2**97), uint192(2), CEIL)), uint256(FIX_MAX));
