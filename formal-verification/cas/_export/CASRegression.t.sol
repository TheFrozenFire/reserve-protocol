    function test_furnace_payoutRatio_one_day_at_max_ratio() public pure {
        uint192 ratio = uint192(1e14); // MAX_RATIO
        uint48 N = 86400;
        uint192 oneMinusR = uint192(FIX_ONE) - ratio;
